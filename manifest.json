{
    "manifest_version": 3,
    "name": "__MSG_appName__",
    "version": "2.01",
    "description": "__MSG_appDescription__",
    "default_locale": "en",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "https://nominatim.openstreetmap.org/*",
        "https://stac.overturemaps.org/*",
        "https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.openstreetmap.org/edit*",
                "https://www.openstreetmap.org/id"
            ],
            "js": [
                "simplify-core.js",
                "fixer-core.js",
                "src/fixer-bridge.js",
                "src/simplify-bridge.js",
                "src/draw-building.js",
                "src/id-bridge.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        },
        {
            "matches": [
                "https://www.openstreetmap.org/edit*",
                "https://www.openstreetmap.org/id"
            ],
            "js": [
                "panel-session.js",
                "ui-i18n.js",
                "content.js",
                "dist/overture.js",
                "draw-building-control.js",
                "fixer-core.js",
                "fixer.js",
                "simplify.js"
            ],
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "_locales/en/messages.json"
            ],
            "matches": [
                "https://www.openstreetmap.org/*"
            ]
        }
    ],
    "icons": {
        "48": "icon.png"
    }
}
